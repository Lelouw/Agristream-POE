<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriStream IoT</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark agri-nav mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">AgriStream IoT</a>
            <ul class="navbar-nav me-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Field dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Images" asp-action="Index">Drone images</a></li>
                    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Agronomist))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Images" asp-action="Audit">Image audit</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav align-items-md-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item text-light me-3">@User.Identity.Name (@User.Claims.First(c => c.Type == System.Security.Claims.ClaimTypes.Role).Value)</li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
</body>
</html>
