@model DashboardViewModel
@{
    ViewData["Title"] = "Field dashboard";
    var canControl = User.IsInRole(Roles.Farmer) || User.IsInRole(Roles.Admin);
}

<h1 class="h3 mb-3">Field dashboard</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-warning">@Model.Error</div>
}

<div class="card mb-4"><div class="card-body">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-auto">
            <label for="field" class="form-label">Field</label>
            <select id="field" name="field" class="form-select">
                <option value="">All fields</option>
                @foreach (var field in Model.Fields)
                {
                    <option value="@field" selected="@(field == Model.Field)">@field</option>
                }
            </select>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-success">Show</button></div>
    </form>

    @if (canControl && !string.IsNullOrEmpty(Model.Field))
    {
        <form method="post" asp-action="SimulateReadings" class="mt-3">
            <input type="hidden" name="field" value="@Model.Field" />
            <input type="hidden" name="count" value="10" />
            <button type="submit" class="btn btn-sm btn-outline-secondary">Add 10 sensor readings to @Model.Field</button>
        </form>
    }
</div></div>

<h2 class="h5">Latest telemetry</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped bg-white">
        <thead><tr><th>Field</th><th>Sensor</th><th>Soil moisture (%)</th><th>Temperature (&deg;C)</th><th>pH</th><th>Reading time (UTC)</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Readings)
            {
                <tr>
                    <td>@r.FieldId</td>
                    <td>@r.SensorId</td>
                    <td>@r.SoilMoisture</td>
                    <td>@r.TemperatureC</td>
                    <td>@r.Ph</td>
                    <td>@r.ReadingAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
            @if (!Model.Readings.Any())
            {
                <tr><td colspan="6" class="text-muted">No readings yet.</td></tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5">Devices</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped bg-white align-middle">
        <thead><tr><th>Device</th><th>Field</th><th>Status</th><th>Last command</th><th>Updated (UTC)</th>@if (canControl) { <th></th> }</tr></thead>
        <tbody>
            @foreach (var d in Model.Devices)
            {
                <tr>
                    <td>@d.Name</td>
                    <td>@d.FieldName</td>
                    <td>@d.Status</td>
                    <td>@d.LastCommand</td>
                    <td>@d.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    @if (canControl)
                    {
                        <td>
                            <form method="post" asp-action="TriggerIrrigation" class="d-flex gap-2">
                                <input type="hidden" name="deviceId" value="@d.DeviceId" />
                                <input type="hidden" name="fieldName" value="@d.FieldName" />
                                <input type="number" name="durationMinutes" value="15" min="1" max="120" class="form-control form-control-sm" style="width: 5rem" />
                                <button type="submit" class="btn btn-sm btn-success">Trigger irrigation</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
