@model IReadOnlyList<ImageAuditRecord>
@{
    ViewData["Title"] = "Image audit";
}

<h1 class="h3 mb-3">Image processing audit</h1>

<div class="table-responsive">
    <table class="table table-sm table-striped bg-white">
        <thead><tr><th>File</th><th>Size (KB)</th><th>Uploaded by</th><th>Status</th><th>Processed (UTC)</th></tr></thead>
        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.FileName</td>
                    <td>@((record.SizeBytes / 1024.0).ToString("N1"))</td>
                    <td>@record.UploadedBy</td>
                    <td>@record.Status</td>
                    <td>@record.ProcessedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No audit entries yet.</td></tr>
            }
        </tbody>
    </table>
</div>
